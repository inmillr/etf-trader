{
  "name": "etf-trader",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "backfill": "node --import=tsx src/scripts/backfillHistoricalData.ts",
    "backfill:universe": "node --import=tsx src/scripts/backfillUniverse.ts",
    "backfill:once": "node --import=tsx src/scripts/backfillOnce.ts",
    "backfill:once:5m": "node --import=tsx src/scripts/backfillOnce.ts 5m 2025-01-01 2026-08-13",
    "aggregate:daily": "node --import=tsx src/scripts/aggregateLocalDaily.ts",
    "scan": "node --import=tsx src/scripts/scanUniverse.ts",
    "signal": "node --import=tsx src/scripts/dailySignal.ts",
    "paper:status": "node --import=tsx src/scripts/paperStatus.ts",
    "paper:trade": "node --import=tsx src/scripts/paperTrade.ts",
    "automate": "INHIBIT_WHY=\"ETF trader automation\" ./scripts/with-inhibit.sh node --import=tsx src/scripts/runAutomation.ts",
    "automate:tick": "node --import=tsx src/scripts/automationTick.ts",
    "journal": "node --import=tsx src/scripts/dailyJournal.ts",
    "backtest": "node --import=tsx src/scripts/runAggressiveBacktest.ts",
    "backtest:aggressive": "node --import=tsx src/scripts/runAggressiveBacktest.ts",
    "backtest:execution": "node --import=tsx src/scripts/compareExecutionTiming.ts",
    "backtest:hybrid": "node --import=tsx src/scripts/runHybridBacktest.ts",
    "sweep:aggressive": "node --import=tsx src/scripts/sweepAggressive.ts",
    "sweep:hybrid": "node --import=tsx src/scripts/sweepHybrid2026.ts",
    "backtest:adaptive": "node --import=tsx src/scripts/runAdaptiveBacktest.ts",
    "backtest:intraday": "node --import=tsx src/scripts/runAdaptiveIntradayBacktest.ts",
    "backtest:dual-momentum": "node --import=tsx src/scripts/runAdaptiveBacktest.ts --compare",
    "dev:web": "npm run dev --prefix web",
    "dev:web:remote": "npm run dev:remote --prefix web",
    "build:web": "npm run build --prefix web",
    "start:web:remote": "npm run start:remote --prefix web"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^4.0.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2"
  }
}
