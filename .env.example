# Alpaca credentials
# Used for historical data backfill AND paper trading (when enabled below).
#
# Setup:
#   1. cp .env.example .env
#   2. Add your Alpaca API key and secret from the dashboard
#   3. npm run backfill:once          # download daily bars to SQLite
#   4. npm run paper:status           # verify paper API access (optional until account exists)
#
# Paper trading (off by default until you opt in):
#   • Enable paper trading in the Alpaca dashboard
#   • Set PAPER_TRADING_ENABLED=true
#   • npm run signal                  # preview today's aggressive signal
#   • npm run paper:trade             # dry-run order plan (default)
#   • npm run paper:trade -- --offline  # preview without Alpaca API
#   • npm run paper:trade -- --execute  # submit orders when enabled

ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here

# true = paper-api.alpaca.markets (default). false = live — requires ALPACA_ALLOW_LIVE=true
ALPACA_PAPER=true

# Must be true to submit orders via npm run paper:trade -- --execute
PAPER_TRADING_ENABLED=false

# Safety gate when ALPACA_PAPER=false
ALPACA_ALLOW_LIVE=false

# Fraction of buying power kept in reserve when sizing market buys (0.01 = 1%)
PAPER_CASH_RESERVE_PERCENT=0.01

DATABASE_PATH=./data/market.db

# Backtest and signal scripts (default: 1000)
INITIAL_CASH=1000

# Tracks hypothetical / last-synced hold for signal scripts
SIGNAL_STATE_PATH=./data/signal-state.json

# Automation scheduler state (enabled flag, run history, daemon PID)
AUTOMATION_STATE_PATH=./data/automation-state.json

# Optional: daemon poll interval in ms (default 60000)
# AUTOMATION_POLL_MS=60000

# Optional: used by Next.js dashboard (web/)
# PROJECT_ROOT is set automatically by web/next.config.ts
