# Alpaca credentials — used ONLY for one-time historical data download.
# Does NOT place trades or call trading endpoints.
#
# Setup (once):
#   1. cp .env.example .env
#   2. Fill in ALPACA_API_KEY and ALPACA_API_SECRET below
#   3. npm run backfill:once
#
# After backfill, backtests and scans use local SQLite only.
# You can remove these keys from .env when done downloading.

ALPACA_API_KEY=PKYHZHOOJIUSEZOMGJAL74B6KJX
ALPACA_API_SECRET=5THzoFvdfwwukTjhbgD3uXuQAewCmK3ksFYMB31rShe6X

# Not used for data backfill; kept for future live trading setup
ALPACA_PAPER=true

DATABASE_PATH=./data/market.db

# Backtest and signal scripts (default: 1000)
INITIAL_CASH=1000
